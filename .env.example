# ---------------------------------------------------------------------------
# Fixam — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string (omit the db name — set it below).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="fixam"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret     (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) -------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Fixam <noreply@fixam.ng>"
EMAIL_REPLY_TO="support@fixam.ng"
# Where the "new artisan awaiting approval" digest goes.
ADMIN_NOTIFY_EMAIL="admin@fixam.ng"

# --- Media (Cloudinary) ---------------------------------------------------
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="fixam"
# Public — used by the browser upload widget. Same value as CLOUDINARY_CLOUD_NAME.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cron -----------------------------------------------------------------
# Shared secret for /api/cron/* (review prompts, weekly lead digest).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# --- Security -------------------------------------------------------------
# Salt for hashing IP / user-agent fingerprints stored on lead records.
# Kept separate from AUTH_SECRET so either can be rotated independently.
FINGERPRINT_SALT=""
